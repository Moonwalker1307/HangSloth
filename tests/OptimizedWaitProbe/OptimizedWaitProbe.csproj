<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built and run by OptimizedWaitTargetEndToEndTests only (not in the solution; the test copies it into its
       run folder first): waits whose target is easy to get wrong once the framework's wait method is inlined. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
