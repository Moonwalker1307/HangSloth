<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>hangsloth</AssemblyName>
    <RootNamespace>HangSloth.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hangsloth</ToolCommandName>
    <PackageId>HangSloth</PackageId>
    <Description>Point it at a hung .NET process or memory dump and it explains in plain language why it's stuck: sync-over-async and lock deadlocks, wait cycles, lock contention, thread pool starvation, blocked HTTP calls, full queues and database waits, with file and line numbers.</Description>
    <PackageTags>dotnet;diagnostics;hang;deadlock;dump;clrmd;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Moonwalker1307/HangSloth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Moonwalker1307/HangSloth</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HangSloth.Core\HangSloth.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HangSloth.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
