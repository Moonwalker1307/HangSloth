<Project>
  <!-- Built once per driver version: dotnet build -p:NpgsqlVersion=6.0.13 -o <dir>. Each version restores into
       its own obj folder, so builds of different versions don't overwrite each other's restore. -->
  <PropertyGroup>
    <NpgsqlVersion Condition="'$(NpgsqlVersion)' == ''">10.0.3</NpgsqlVersion>
    <SqlClientVersion Condition="'$(SqlClientVersion)' == ''">7.1.2</SqlClientVersion>
    <DriverVersions>npgsql-$(NpgsqlVersion)-sqlclient-$(SqlClientVersion)</DriverVersions>
    <BaseIntermediateOutputPath>obj/$(DriverVersions)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(DriverVersions)/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>portable</DebugType>
    <IsPackable>false</IsPackable>
    <!-- Old driver versions on purpose: their published advisories don't matter for a sample that only hangs. -->
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <!-- The other versions' obj folders are not source files of this one. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="$(SqlClientVersion)" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
